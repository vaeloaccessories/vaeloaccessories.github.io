rules_version = '2';
// VAELO · Veritabanı güvenlik kuralları
// Bu dosya Firebase konsolunda Firestore > Rules (Kurallar) bölümüne yapıştırılır.
// Kısaca: ziyaretçiler yalnızca kendi kayıtlarını YAZABİLİR, her şeyi OKUYABİLEN tek kişi adminidir.
service cloud.firestore {
  match /databases/{database}/documents {

    function admin() {
      return request.auth != null
        && request.auth.token.email == 'vaeloaccessories@gmail.com'
        && request.auth.token.email_verified == true;
    }
    function kisa(x, n) {
      return x == null || (x is string && x.size() <= n);
    }
    function benim(uid) {
      return uid == null || (request.auth != null && uid == request.auth.uid);
    }
    // Sayaçlar sayı olmalı ve her seferde en fazla 5 artabilir (sahte istatistik ve zararlı kod engeli).
    function sayac(f) {
      return !(f in request.resource.data) || (request.resource.data[f] is int
        && request.resource.data[f] - (resource == null ? 0 : resource.data.get(f, 0)) >= 0
        && request.resource.data[f] - (resource == null ? 0 : resource.data.get(f, 0)) <= 5);
    }
    function harita(f) {
      return !(f in request.resource.data) || request.resource.data[f] is map;
    }
    function metin(f, n) {
      return !(f in request.resource.data) || request.resource.data[f] == null
        || (request.resource.data[f] is string && request.resource.data[f].size() <= n);
    }

    // Günlük toplam sayılar (ziyaret, sayfa, ürün görüntüleme, sepete ekleme...)
    match /gunluk/{g} {
      allow read, delete: if admin();
      allow create, update: if g.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['sayfa', 'oturum', 'urun', 'sepet', 'odeme', 'siparis', 'uye'])
        && sayac('sayfa') && sayac('oturum') && sayac('odeme') && sayac('siparis') && sayac('uye')
        && harita('urun') && harita('sepet')
        && request.resource.data.get('urun', {}).size() < 300
        && request.resource.data.get('sepet', {}).size() < 300;
    }

    // Ziyaretçi hareketleri (kim, hangi sayfaya / ürüne baktı)
    match /olaylar/{id} {
      allow read, delete: if admin();
      allow create: if request.resource.data.keys().hasOnly(['t', 'tur', 'sayfa', 'oturum', 'uye', 'cihaz', 'kaynak', 'urun', 'ad'])
        && request.resource.data.t == request.time
        && request.resource.data.tur in ['sayfa', 'urun', 'sepet', 'odeme', 'uye']
        && kisa(request.resource.data.sayfa, 200)
        && kisa(request.resource.data.oturum, 40)
        && kisa(request.resource.data.uye, 160)
        && kisa(request.resource.data.cihaz, 20)
        && kisa(request.resource.data.kaynak, 80)
        && kisa(request.resource.data.get('urun', null), 40)
        && kisa(request.resource.data.get('ad', null), 160);
    }

    // Ziyaretçilerin o anki sepetleri
    match /sepetler/{z} {
      allow read, delete: if admin();
      allow create, update: if z.size() <= 40
        && request.resource.data.keys().hasOnly(['urunler', 'toplam', 'guncel', 'uye', 'ad', 'email', 'cihaz'])
        && request.resource.data.urunler is list
        && request.resource.data.urunler.size() <= 30
        && request.resource.data.guncel == request.time
        && request.resource.data.toplam is number
        && metin('ad', 160) && metin('email', 160) && metin('cihaz', 20) && metin('uye', 160)
        && benim(request.resource.data.uye);
    }

    // Üyeler
    match /uyeler/{uid} {
      allow read: if admin() || (request.auth != null && request.auth.uid == uid);
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['ad', 'email', 'kayit', 'son', 'bulten', 'cihaz'])
        && request.resource.data.email == request.auth.token.email
        && kisa(request.resource.data.ad, 120)
        && request.resource.data.get('bulten', false) is bool
        && metin('cihaz', 20);
      allow update: if admin() || (request.auth != null && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['son', 'ad', 'bulten'])
        && kisa(request.resource.data.ad, 120)
        && request.resource.data.get('bulten', false) is bool);
      allow delete: if admin();
    }

    // Ürünler: admin panelinden düzenlenir, herkes okuyabilir (site bunları 10 dakikada bir işler)
    match /urunler/{id} {
      allow read: if true;
      allow write: if admin() && id.matches('^[0-9]{6,14}$')
        && request.resource.data.keys().hasOnly(['name', 'price', 'category', 'description', 'images', 'aktif', 'guncel'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 120
        && request.resource.data.price is number
        && request.resource.data.images is list && request.resource.data.images.size() <= 6
        && kisa(request.resource.data.description, 4000);
      allow delete: if admin();
    }
    // Panelden yüklenen ürün fotoğrafları
    match /urun_gorsel/{id} {
      allow read: if true;
      allow write, delete: if admin();
    }

    // Siparişler (ödeme ekranına geçildiği an kaydedilir)
    match /siparisler/{no} {
      allow read: if admin() || (request.auth != null && resource.data.uid == request.auth.uid);
      allow create: if no.matches('^VAELO[0-9]{10,20}$')
        && request.resource.data.keys().hasOnly(['t', 'durum', 'toplam', 'ad', 'email', 'tel', 'il', 'ilce', 'adres', 'hediye', 'urunler', 'uid'])
        && request.resource.data.t == request.time
        && request.resource.data.durum == 'odeme-ekrani'
        && request.resource.data.urunler is list
        && request.resource.data.urunler.size() <= 30
        && request.resource.data.toplam is number
        && request.resource.data.hediye is bool
        && metin('ad', 120) && metin('email', 160) && metin('tel', 40)
        && metin('il', 60) && metin('ilce', 60) && metin('adres', 500)
        && benim(request.resource.data.uid);
      // Müşteri yalnızca kendi siparişini, ödeme ekranına geçtikten sonraki 2 saat içinde "ödedim" yapabilir.
      allow update: if admin() || (resource.data.durum == 'odeme-ekrani'
        && request.time < resource.data.t + duration.value(2, 'h')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['durum'])
        && request.resource.data.durum == 'musteri-dondu');
      allow delete: if admin();
    }
    // Müşteri yorumları: herkes yazabilir (onaysız), sitede yalnızca admin onayladıkları görünür.
    match /yorumlar/{id} {
      allow read: if admin() || resource.data.onay == true;
      allow create: if request.resource.data.keys().hasOnly(['urun', 'urunAd', 'ad', 'baslik', 'yorum', 'puan', 'onay', 't'])
        && request.resource.data.urun is string && request.resource.data.urun.matches('^[a-z0-9]{1,20}$')
        && request.resource.data.onay == false
        && request.resource.data.puan is int && request.resource.data.puan >= 1 && request.resource.data.puan <= 5
        && request.resource.data.ad is string && request.resource.data.ad.size() > 0 && request.resource.data.ad.size() <= 40
        && request.resource.data.yorum is string && request.resource.data.yorum.size() >= 5 && request.resource.data.yorum.size() <= 600
        && kisa(request.resource.data.baslik, 60) && kisa(request.resource.data.urunAd, 120)
        && request.resource.data.t == request.time;
      allow update, delete: if admin();
    }
  }
}
